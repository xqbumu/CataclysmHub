{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "environment-profile v1 design draft",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "profile_id": {
      "type": "string",
      "format": "uuid"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "game": {
      "type": "object",
      "properties": {
        "branch": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": [
            "string",
            "null"
          ]
        },
        "platform": {
          "type": "string",
          "minLength": 1
        },
        "arch": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "branch",
        "version",
        "platform",
        "arch"
      ],
      "additionalProperties": false
    },
    "launch_args": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "content": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "enum": [
              "mod",
              "soundpack",
              "tileset",
              "font"
            ]
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": [
              "string",
              "null"
            ]
          },
          "role": {
            "type": "string",
            "minLength": 1
          },
          "enabled": {
            "type": "boolean"
          },
          "order": {
            "type": "integer",
            "minimum": 0
          },
          "source_url": {
            "type": [
              "string",
              "null"
            ]
          },
          "sha256": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "compatibility": {
            "enum": [
              "tested",
              "upstream_declared",
              "inferred",
              "unverified",
              "incompatible"
            ]
          }
        },
        "required": [
          "type",
          "name",
          "version",
          "role",
          "enabled",
          "order",
          "source_url",
          "sha256",
          "compatibility"
        ],
        "additionalProperties": true
      }
    },
    "config_refs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "relative_path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "relative_path",
          "sha256"
        ],
        "additionalProperties": true
      }
    },
    "omitted_fields": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "extensions": {
      "type": "object"
    }
  },
  "required": [
    "schema_version",
    "profile_id",
    "name",
    "created_at",
    "game",
    "launch_args",
    "content",
    "config_refs",
    "omitted_fields",
    "extensions"
  ],
  "additionalProperties": true
}
